generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Jogo {
  id        Int      @id @default(autoincrement())
  timeCasa  String
  timeFora  String
  golsCasa  Int      @default(0)
  golsFora  Int      @default(0)
  fase      String
  dataJogo  DateTime
  createdAt DateTime @default(now())
}
